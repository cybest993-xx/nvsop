#!/usr/bin/env python3
"""Git pre-commit hook: the rules every agent and developer must hit before a commit lands.

Enabled by `make hooks` (`git config core.hooksPath scripts/githooks`), so it holds for any
tool that commits through git — Claude Code, Codex, pi, or a person — with no per-agent
configuration. Standard library only: it must run before `make sync` has ever been run.

Three refusals, each carrying the rule it enforces:

- no direct commit on `main` or legacy `dev`: task work stays on `agent/...`, is pushed as that
  branch, and reaches `main` only through a pull request; the reference-transaction hook is the
  final guard for local ref updates;
- no staged change under `vendor/`: the NVIDIA base changes only through `git subtree pull`
  (which merges and does not pass here) or the recorded patch (ADR-0007) — set
  `NVSOP_VENDOR_PATCH=1` to commit a patch change deliberately;
- no unformatted Python: the engineering workflow requires committed Python to pass the
  repository formatter; the hook checks the bytes in Git's index, not unrelated worktree edits.

The full gate stays `make check`; this is the subset that is cheap enough to run on every
commit and whose violation is expensive to unwind afterwards.
"""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

PROTECTED_BRANCHES = {"main", "dev"}
VENDOR = "vendor"
VENDOR_OVERRIDE = "NVSOP_VENDOR_PATCH"


def git(*args: str) -> str:
    return subprocess.run(["git", *args], check=True, capture_output=True, text=True).stdout


def staged_files(diff_filter: str) -> list[Path]:
    output = git(
        "diff", "--cached", "--name-only", "--no-renames", f"--diff-filter={diff_filter}", "-z"
    )
    return [Path(name) for name in output.split("\0") if name]


def staged_blob(path: Path) -> bytes:
    return subprocess.run(
        ["git", "show", f":{path.as_posix()}"], check=True, capture_output=True
    ).stdout


def refuse_protected_branch() -> list[str]:
    branch = git("rev-parse", "--abbrev-ref", "HEAD").strip()
    if branch not in PROTECTED_BRANCHES:
        return []
    return [
        f"this tree is on `{branch}`; make task changes on `agent/<agent-id>/<task-slug>`, "
        "push that branch, and open its pull request directly against `main`."
    ]


def refuse_vendor_edits(staged: list[Path]) -> list[str]:
    touched = [path for path in staged if path.parts[:1] == (VENDOR,)]
    if not touched or os.environ.get(VENDOR_OVERRIDE) == "1":
        return []
    listed = ", ".join(str(path) for path in touched[:5])
    return [
        f"{listed} is NVIDIA base code, changed only by `git subtree pull` or the recorded "
        "patch in docs/base/patches/ (ADR-0007). Put the behaviour in apps/edge-runtime/ "
        f"behind the existing hook. To commit a change to the patch itself, set "
        f"{VENDOR_OVERRIDE}=1 and regenerate the .patch file and its contract test in the "
        "same commit."
    ]


def refuse_unformatted_python(root: Path, staged: list[Path]) -> list[str]:
    ruff = root / ".nvsop" / "venv" / "bin" / "ruff"
    python = [path for path in staged if path.suffix == ".py" and path.parts[:1] != (VENDOR,)]
    if not python:
        return []
    if not ruff.is_file():
        return ["staged Python formatting was not checked: run `make sync`, then commit again."]

    unformatted: list[str] = []
    for path in python:
        result = subprocess.run(
            [
                ruff,
                "format",
                "--check",
                "--quiet",
                "--stdin-filename",
                path.as_posix(),
                "-",
            ],
            cwd=root,
            input=staged_blob(path),
            capture_output=True,
        )
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).decode("utf-8", errors="replace").strip()
            unformatted.append(f"{path}: {detail}" if detail else str(path))
    if not unformatted:
        return []
    return [
        "staged Python is not formatted: run `.nvsop/venv/bin/ruff format` on the source files, "
        "stage them again, and retry.\n" + "\n".join(unformatted)
    ]


def main() -> int:
    root = Path(git("rev-parse", "--show-toplevel").strip())
    staged = staged_files("ACMR")
    errors = (
        refuse_protected_branch()
        + refuse_vendor_edits(staged_files("ACMRD"))
        + refuse_unformatted_python(root, staged)
    )
    if not errors:
        return 0
    print("pre-commit refused this commit:", file=sys.stderr)
    for error in errors:
        print(f"- {error}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
