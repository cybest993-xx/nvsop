# Local configuration and secrets
.env
.env.*
!.env.example
*.key
*.pem

# Repository-owned local state. Supported repository commands keep generated
# environments, caches, tools, artifacts and the fixed dev instance below this root.
.nvsop/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
# Editable-install metadata written by `uv sync` into each workspace member.
*.egg-info/

# Node / Vue
node_modules/
dist/
coverage/
playwright-report/
test-results/

# Editors and operating systems
.idea/
.vscode/
.DS_Store

# Local runtime output
.tmp/
tmp/
logs/
