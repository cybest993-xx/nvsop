          <td>海康 ISAPI</td>
          <td>一号装配工位</td>
          <td>推理机 A</td>
          <td><span>192.168.10.21</span><span> :80</span></td>
          <td><span class="el-tag el-tag--success el-tag--light"><span class="el-tag__content">已配置</span>
            <!--v-if--></span>
          </td>
          <td><span class="el-tag el-tag--warning el-tag--light"><span class="el-tag__content">未验证</span>
            <!--v-if--></span>
          </td>
          <td><span class="el-tag el-tag--success el-tag--light"><span class="el-tag__content">在用</span>
            <!--v-if--></span>
          </td>
          <td class="devices__row-actions"><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
              <!--v-if--><span class="">详情</span>
            </button><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
              <!--v-if--><span class=""> 编辑 </span>
            </button><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
              <!--v-if--><span class="">停用</span>
            </button><button aria-disabled="false" type="button" class="el-button el-button--danger is-link">
              <!--v-if--><span class=""> 删除 </span>
            </button></td>
        </tr>
        <!--v-if-->
      </tbody>
    </table>
  </div>
  <!--teleport start-->
  <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
    <div class="el-overlay el-modal-dialog" style="z-index: 2010;">
      <div role="dialog" aria-modal="true" aria-label="新建连接器" aria-describedby="el-id-18" class="el-overlay-dialog">
        <div class="el-dialog" style="--el-dialog-width: 38rem;" tabindex="-1">
          <header class="el-dialog__header show-close"><span role="heading" aria-level="2" class="el-dialog__title">新建连接器</span><button aria-label="Close this dialog" class="el-dialog__headerbtn" type="button"><i class="el-icon el-dialog__close"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024">
                  <path fill="currentColor" d="M764.288 214.592 512 466.88 259.712 214.592a31.936 31.936 0 0 0-45.12 45.12L466.752 512 214.528 764.224a31.936 31.936 0 1 0 45.12 45.184L512 557.184l252.288 252.288a31.936 31.936 0 0 0 45.12-45.12L557.12 512.064l252.288-252.352a31.936 31.936 0 1 0-45.12-45.184z"></path>
                </svg></i></button></header>
          <div id="el-id-18" class="el-dialog__body">
            <p class="devices__form-note">这里只保存地址和端口等非秘密参数；凭据由推理机本地配置。</p>
            <form class="el-form el-form--default el-form--label-top">
              <!--v-if-->
              <div class="devices__form-grid">
                <div class="el-form-item asterisk-left el-form-item--label-top"><label id="el-id-21" for="connector-name" class="el-form-item__label">名称</label>
                  <div class="el-form-item__content">
                    <div class="el-input">
                      <!-- input -->
                      <!-- prepend slot -->
                      <!--v-if-->
                      <div class="el-input__wrapper" tabindex="-1">
                        <!-- prefix slot -->
                        <!--v-if--><input class="el-input__inner" name="name" type="text" autocomplete="off" tabindex="0" id="connector-name"><!-- suffix slot -->
                        <!--v-if-->
                      </div><!-- append slot -->
                      <!--v-if-->
                    </div>
                    <!--v-if-->
                    <transition-group-stub name="el-zoom-in-top" appear="false" persisted="false" css="true">
                      <!--v-if-->
                    </transition-group-stub>
                  </div>
                </div>
                <div class="el-form-item asterisk-left el-form-item--label-top"><label id="el-id-22" for="el-id-37" class="el-form-item__label">类型</label>
                  <div class="el-form-item__content">
                    <div class="el-select devices__select">
                      <div class="el-select__wrapper el-tooltip__trigger el-tooltip__trigger" tabindex="-1">
                        <!--v-if-->
                        <div class="el-select__selection">
                          <!--v-if-->
                          <div class="el-select__selected-item el-select__input-wrapper is-hidden"><input type="text" class="el-select__input" autocomplete="off" style="min-width: 11px;" tabindex="0" role="combobox" readonly="" spellcheck="false" aria-activedescendant="" aria-controls="el-id-23" aria-expanded="false" aria-label="连接器类型" aria-autocomplete="none" aria-haspopup="listbox" value="" id="el-id-37">
                            <!--v-if-->
                          </div>
                          <div class="el-select__selected-item el-select__placeholder"><span>海康 ISAPI</span></div>
                        </div>
                        <div class="el-select__suffix"><i class="el-icon el-select__caret el-select__icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1024 1024">
                              <path fill="currentColor" d="M831.872 340.864 512 652.672 192.128 340.864a30.59 30.59 0 0 0-42.752 0 29.12 29.12 0 0 0 0 41.6L489.664 714.24a32 32 0 0 0 44.672 0l340.288-331.712a29.12 29.12 0 0 0 0-41.728 30.59 30.59 0 0 0-42.752 0z"></path>
                            </svg></i>
                          <!--v-if-->
                          <!--v-if-->
                        </div>
                      </div>
                      <!--teleport start-->
                      <!--teleport end-->
                    </div>
                    <!--v-if-->
                    <transition-group-stub name="el-zoom-in-top" appear="false" persisted="false" css="true">
                      <!--v-if-->
                    </transition-group-stub>
                  </div>
                </div>
                <div class="el-form-item asterisk-left el-form-item--label-top"><label id="el-id-27" for="connector-address" class="el-form-item__label">地址</label>
                  <div class="el-form-item__content">
