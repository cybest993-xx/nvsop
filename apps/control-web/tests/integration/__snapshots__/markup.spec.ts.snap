exports[`the access page > renders the accounts and roles an administrator works with 1`] = `
"<section aria-labelledby="access-heading">
  <h1 id="access-heading" class="access__heading">用户与权限</h1>
  <!-- \`role="alert"\` so a refusal is announced rather than only appearing; the text carries the
         state, not the colour (Q32). -->
  <!--v-if-->
  <div class="el-tabs el-tabs--top">
    <div class="el-tabs__header is-top">
      <div class="el-tabs__nav-wrap is-top">
        <!---->
        <div class="el-tabs__nav-scroll">
          <div class="el-tabs__nav is-top" style="transform: translateX(-0px);" role="tablist">
            <div class="el-tabs__active-bar is-top" style="transition: none; width: 0px; transform: translateX(0px);"></div>
            <div class="el-tabs__item is-top" id="tab-users" aria-controls="pane-users" role="tab" aria-selected="false" tabindex="-1">账户
              <!---->
            </div>
            <div class="el-tabs__item is-top" id="tab-roles" aria-controls="pane-roles" role="tab" aria-selected="false" tabindex="-1">角色
              <!---->
            </div>
          </div>
        </div>
      </div>
      <!---->
    </div>
    <div class="el-tabs__content">
      <div id="pane-users" class="el-tab-pane" role="tabpanel" aria-hidden="true" aria-labelledby="tab-users" style="display: none;">
        <div class="panel">
          <div class="panel__actions"><button aria-disabled="false" type="button" class="el-button el-button--primary">
              <!--v-if--><span class="">新建账户</span>
            </button></div>
          <!--v-if-->
          <p class="panel__loading">正在加载…</p>
          <!--teleport start-->
          <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
            <div class="el-overlay el-modal-dialog" style="z-index: 2001; display: none;">
              <div role="dialog" aria-modal="true" aria-label="新建账户" aria-describedby="el-id-4" class="el-overlay-dialog"></div>
            </div>
          </transition-stub>
          <!--teleport end-->
          <!--teleport start-->
          <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
            <div class="el-overlay el-modal-dialog" style="z-index: 2002; display: none;">
              <div role="dialog" aria-modal="true" aria-label="修改姓名" aria-describedby="el-id-6" class="el-overlay-dialog"></div>
            </div>
          </transition-stub>
          <!--teleport end-->
          <!--teleport start-->
          <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
            <div class="el-overlay el-modal-dialog" style="z-index: 2003; display: none;">
              <div role="dialog" aria-modal="true" aria-label="重置密码" aria-describedby="el-id-8" class="el-overlay-dialog"></div>
            </div>
          </transition-stub>
          <!--teleport end-->
          <!--teleport start-->
          <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
            <div class="el-overlay el-modal-dialog" style="z-index: 2004; display: none;">
              <div role="dialog" aria-modal="true" aria-label="分配角色" aria-describedby="el-id-10" class="el-overlay-dialog"></div>
            </div>
          </transition-stub>
          <!--teleport end-->
        </div>
      </div>
      <div id="pane-roles" class="el-tab-pane" role="tabpanel" aria-hidden="true" aria-labelledby="tab-roles" style="display: none;">
        <div class="panel">
          <div class="panel__actions"><button aria-disabled="false" type="button" class="el-button el-button--primary">
              <!--v-if--><span class=""> 新建角色 </span>
            </button></div>
          <!--v-if-->
          <p class="panel__loading">正在加载…</p>
          <!--teleport start-->
          <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
            <div class="el-overlay el-modal-dialog" style="z-index: 2005; display: none;">
              <div role="dialog" aria-modal="true" aria-label="新建角色" aria-describedby="el-id-12" class="el-overlay-dialog"></div>
            </div>
          </transition-stub>
          <!--teleport end-->
        </div>
      </div>
    </div>
  </div>
</section>"
`;

exports[`the device page > renders connector configuration with a delegated test control 1`] = `
"<section aria-labelledby="devices-heading">
  <header class="devices__header">
    <div>
      <p class="devices__eyebrow">配置中心 / 设备</p>
      <h1 id="devices-heading" class="devices__heading">工位与设备</h1>
      <p class="devices__intro">管理连接器与点位的归属、语义和非秘密配置；实测能力单独登记。</p>
    </div><button aria-disabled="false" type="button" class="el-button el-button--primary">
      <!--v-if--><span class=""> 新建连接器 </span>
    </button>
  </header>
  <!--v-if-->
  <div class="devices__surface">
    <div class="devices__surface-head">
      <div>
        <h2 class="devices__title">连接器</h2>
        <p class="devices__meta">1 个配置</p>
      </div>
      <p class="devices__surface-note">中心不保存设备凭据</p>
    </div>
    <table class="devices__table">
      <caption class="devices__caption"> 已配置的连接器，含已停用记录 </caption>
      <thead>
        <tr>
          <th scope="col">名称</th>
          <th scope="col">类型</th>
          <th scope="col">所属工位</th>
          <th scope="col">推理机</th>
          <th scope="col">连接参数</th>
          <th scope="col">凭据</th>
          <th scope="col">连接状态</th>
          <th scope="col">状态</th>
          <th scope="col">操作</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row"><button aria-disabled="false" type="button" class="el-button el-button--primary is-link devices__connector-link">
              <!--v-if--><span class="">装配线输入</span>
            </button></th>
          <td>海康 ISAPI</td>
          <td>一号装配工位</td>
          <td>推理机 A</td>
          <td><span>192.168.10.21</span><span> :80</span></td>
          <td><span class="el-tag el-tag--success el-tag--light"><span class="el-tag__content">已配置</span>
            <!--v-if--></span>
          </td>
          <td><span class="el-tag el-tag--warning el-tag--light"><span class="el-tag__content">未验证</span>
            <!--v-if--></span>
          </td>
          <td><span class="el-tag el-tag--success el-tag--light"><span class="el-tag__content">在用</span>
            <!--v-if--></span>
          </td>
          <td class="devices__row-actions"><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
              <!--v-if--><span class="">详情</span>
            </button><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
              <!--v-if--><span class=""> 编辑 </span>
            </button><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
              <!--v-if--><span class="">停用</span>
            </button><button aria-disabled="false" type="button" class="el-button el-button--danger is-link">
              <!--v-if--><span class=""> 删除 </span>
            </button>
            <div class="connection-test"><button aria-disabled="false" type="button" class="el-button el-button--primary is-plain" aria-label="测试连接：装配线输入">
                <!--v-if--><span class="">测试连接</span>
              </button>
              <!--v-if-->
            </div>
          </td>
        </tr>
        <!--v-if-->
      </tbody>
    </table>
  </div>
  <!--teleport start-->
  <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
    <div class="el-overlay el-modal-dialog" style="z-index: 2006; display: none;">
      <div role="dialog" aria-modal="true" aria-label="新建连接器" aria-describedby="el-id-14" class="el-overlay-dialog"></div>
    </div>
  </transition-stub>
  <!--teleport end-->
  <!--teleport start-->
  <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
    <div class="el-overlay el-modal-dialog" style="z-index: 2007; display: none;">
      <div role="dialog" aria-modal="true" aria-label="连接器详情" aria-describedby="el-id-16" class="el-overlay-dialog"></div>
    </div>
  </transition-stub>
  <!--teleport end-->
  <!--v-if-->
  <!--v-if-->
  <!--v-if-->
  <p role="status">当前没有点位权限；点位列表、表单和状态操作均不会请求。</p>
  <!--v-if-->
  <section aria-labelledby="capability-heading">
    <h3 id="capability-heading">连接器能力声明</h3>
    <table aria-label="连接器能力声明清单">
      <thead>
        <tr>
          <th scope="col">连接器</th>
          <th scope="col">验证状态</th>
          <th scope="col">投递 / 周期</th>
          <th scope="col">轮询周期</th>
          <th scope="col">最大延迟</th>
          <th scope="col">保序</th>
          <th scope="col">边沿</th>
          <th scope="col">时间戳来源</th>
          <th scope="col">操作</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row">装配线输入</th>
          <td>未知能力声明（未提供）</td>
          <td>未提供</td>
          <td>未提供</td>
          <td>未提供</td>
          <td>未提供</td>
          <td>未提供</td>
          <td>未提供</td>
          <td><span>未知值，不能编辑</span></td>
        </tr>
      </tbody>
    </table>
    <!--v-if-->
    <!--v-if-->
    <!--v-if-->
  </section>
  <section aria-labelledby="validation-heading">
    <h3 id="validation-heading">点位角色绑定预检</h3>
    <p role="status">绑定预检需要点位查看权限；当前不会请求点位或连接器详情。</p>
    <!--v-if-->
    <!--v-if-->
    <!--v-if-->
  </section>
</section>"
`;

