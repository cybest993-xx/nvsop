exports[`the access page > renders the accounts and roles an administrator works with 1`] = `
"<section aria-labelledby="access-heading">
  <h1 id="access-heading" class="access__heading">用户与权限</h1>
  <!-- \`role="alert"\` so a refusal is announced rather than only appearing; the text carries the
         state, not the colour (Q32). -->
  <!--v-if-->
  <div class="n-tabs n-tabs--bar-type n-tabs--medium-size n-tabs--top" style="--n-bezier: cubic-bezier(.4, 0, .2, 1); --n-color-segment: rgb(247, 247, 250); --n-bar-color: #1c84c6; --n-tab-font-size: 14px; --n-tab-text-color: #2f4050; --n-tab-text-color-active: #1c84c6; --n-tab-text-color-disabled: #c2c9d1; --n-tab-text-color-hover: #1c84c6; --n-pane-text-color: #676a6c; --n-tab-border-color: #e7eaec; --n-tab-border-radius: 4px; --n-close-size: 18px; --n-close-icon-size: 14px; --n-close-color-hover: rgba(0, 0, 0, .09); --n-close-color-pressed: rgba(0, 0, 0, .13); --n-close-border-radius: 4px; --n-close-icon-color: rgba(102, 102, 102, 1); --n-close-icon-color-hover: rgba(102, 102, 102, 1); --n-close-icon-color-pressed: rgba(102, 102, 102, 1); --n-tab-color: rgb(247, 247, 250); --n-tab-font-weight: 400; --n-tab-font-weight-active: 400; --n-tab-padding: 6px 0; --n-tab-padding-vertical: 8px 16px; --n-tab-gap: 36px; --n-tab-gap-vertical: 8px; --n-pane-padding-left: 0; --n-pane-padding-right: 0; --n-pane-padding-top: 12px; --n-pane-padding-bottom: 0; --n-font-weight-strong: 500; --n-tab-color-segment: #FFF;">
    <div class="n-tabs-nav--bar-type n-tabs-nav--top n-tabs-nav">
      <!---->
      <!---->
      <div class="n-tabs-nav-scroll-wrapper">
        <div class="v-x-scroll">
          <div class="n-tabs-nav-scroll-content">
            <div class="n-tabs-wrapper">
              <div class="n-tabs-scroll-padding" style="width: 0px;"></div>
              <div class="n-tabs-tab-wrapper">
                <!---->
                <div data-name="users" class="n-tabs-tab n-tabs-tab--active"><span class="n-tabs-tab__label">账户</span>
                  <!---->
                </div>
              </div>
              <div class="n-tabs-tab-wrapper">
                <div class="n-tabs-tab-pad"></div>
                <div data-name="roles" class="n-tabs-tab"><span class="n-tabs-tab__label">角色</span>
                  <!---->
                </div>
              </div>
              <!---->
              <div class="n-tabs-scroll-padding" style="width: 0px;"></div>
              <div class="n-tabs-bar"></div>
            </div>
            <!---->
          </div>
        </div>
      </div>
      <!---->
      <!---->
      <!---->
    </div>
    <div class="n-tab-pane">
      <div class="panel">
        <div class="panel__actions"><button class="n-button n-button--primary-type n-button--medium-type" tabindex="0" type="button" style="--n-bezier: cubic-bezier(.4, 0, .2, 1); --n-bezier-ease-out: cubic-bezier(0, 0, .2, 1); --n-ripple-duration: .6s; --n-opacity-disabled: 0.5; --n-wave-opacity: 0.6; --n-font-weight: 400; --n-color: #1c84c6; --n-color-hover: #3a9ad9; --n-color-pressed: #17699f; --n-color-focus: #3a9ad9; --n-color-disabled: #1c84c6; --n-ripple-color: #1c84c6; --n-text-color: #FFF; --n-text-color-hover: #FFF; --n-text-color-pressed: #FFF; --n-text-color-focus: #FFF; --n-text-color-disabled: #FFF; --n-border: 1px solid #1c84c6; --n-border-hover: 1px solid #3a9ad9; --n-border-pressed: 1px solid #17699f; --n-border-focus: 1px solid #3a9ad9; --n-border-disabled: 1px solid #1c84c6; --n-width: initial; --n-height: 34px; --n-font-size: 14px; --n-padding: 0 14px; --n-icon-size: 18px; --n-icon-margin: 6px; --n-border-radius: 4px;">
            <!---->
            <transition-stub name="fade-in-width-expand-transition" appear="false" persisted="false" css="true">
              <!---->
            </transition-stub><span class="n-button__content">新建账户</span>
            <div aria-hidden="true" class="n-base-wave"></div>
            <div aria-hidden="true" class="n-button__border"></div>
            <div aria-hidden="true" class="n-button__state-border"></div>
          </button></div>
        <!--v-if-->
        <p class="panel__loading">正在加载…</p>
        <!---->
        <!---->
        <!---->
        <!---->
      </div>
    </div>
  </div>
</section>"
`;

exports[`the device page > renders connector configuration with a delegated test control 1`] = `
"<section aria-labelledby="devices-heading">
  <header class="devices__header">
    <div>
      <p class="devices__eyebrow">配置中心 / 设备</p>
      <h1 id="devices-heading" class="devices__heading">工位与设备</h1>
      <p class="devices__intro">管理连接器与点位的归属、语义和非秘密配置；实测能力单独登记。</p>
    </div><button class="n-button n-button--primary-type n-button--medium-type" tabindex="0" type="button" style="--n-bezier: cubic-bezier(.4, 0, .2, 1); --n-bezier-ease-out: cubic-bezier(0, 0, .2, 1); --n-ripple-duration: .6s; --n-opacity-disabled: 0.5; --n-wave-opacity: 0.6; --n-font-weight: 400; --n-color: #1c84c6; --n-color-hover: #3a9ad9; --n-color-pressed: #17699f; --n-color-focus: #3a9ad9; --n-color-disabled: #1c84c6; --n-ripple-color: #1c84c6; --n-text-color: #FFF; --n-text-color-hover: #FFF; --n-text-color-pressed: #FFF; --n-text-color-focus: #FFF; --n-text-color-disabled: #FFF; --n-border: 1px solid #1c84c6; --n-border-hover: 1px solid #3a9ad9; --n-border-pressed: 1px solid #17699f; --n-border-focus: 1px solid #3a9ad9; --n-border-disabled: 1px solid #1c84c6; --n-width: initial; --n-height: 34px; --n-font-size: 14px; --n-padding: 0 14px; --n-icon-size: 18px; --n-icon-margin: 6px; --n-border-radius: 4px;">
      <!---->
      <transition-stub name="fade-in-width-expand-transition" appear="false" persisted="false" css="true">
        <!---->
      </transition-stub><span class="n-button__content"> 新建连接器 </span>
      <div aria-hidden="true" class="n-base-wave"></div>
      <div aria-hidden="true" class="n-button__border"></div>
      <div aria-hidden="true" class="n-button__state-border"></div>
    </button>
  </header>
  <!--v-if-->
  <section class="compression" aria-labelledby="compression-heading">
    <div class="compression__header">
      <div>
        <p class="compression__eyebrow">推理机 / 录像管理</p>
        <h2 id="compression-heading">录像压缩归档</h2>
        <p>暂停保留当前进度；中止后从保留原件重新编码。录像仅在校验通过后替换。</p>
      </div><label for="recording-compression-host" class="compression__host">推理机 <select id="recording-compression-host" aria-label="录像压缩推理机">
          <!--v-if-->
          <option value="host-1">推理机 A</option>
        </select></label>
    </div>
    <div class="compression__status" role="status" aria-live="polite"><strong>尚未取得实际状态</strong>
      <!--v-if-->
      <!--v-if-->
      <!--v-if-->
      <!--v-if-->
      <!--v-if-->
      <!--v-if-->
    </div>
    <div class="compression__actions">
      <!--v-if-->
      <!--v-if-->
    </div>
    <!--v-if-->
  </section>
  <!--v-if-->
  <div class="devices__surface">
    <div class="devices__surface-head">
      <div>
        <h2 class="devices__title">连接器</h2>
        <p class="devices__meta">1 个配置</p>
      </div>
      <p class="devices__surface-note">中心不保存设备凭据</p>
    </div>
    <table class="devices__table">
      <caption class="devices__caption"> 已配置的连接器，含已停用记录 </caption>
      <thead>
        <tr>
          <th scope="col">名称</th>
          <th scope="col">类型</th>
          <th scope="col">所属工位</th>
          <th scope="col">推理机</th>
          <th scope="col">连接参数</th>
          <th scope="col">凭据</th>
          <th scope="col">连接状态</th>
          <th scope="col">状态</th>
          <th scope="col">操作</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row"><button class="n-button n-button--primary-type n-button--medium-type devices__connector-link" tabindex="0" type="button" style="--n-bezier: cubic-bezier(.4, 0, .2, 1); --n-bezier-ease-out: cubic-bezier(0, 0, .2, 1); --n-ripple-duration: .6s; --n-opacity-disabled: 0.5; --n-wave-opacity: 0.6; --n-font-weight: 400; --n-color: #1c84c6; --n-color-hover: #3a9ad9; --n-color-pressed: #17699f; --n-color-focus: #3a9ad9; --n-color-disabled: #1c84c6; --n-ripple-color: #1c84c6; --n-text-color: #FFF; --n-text-color-hover: #FFF; --n-text-color-pressed: #FFF; --n-text-color-focus: #FFF; --n-text-color-disabled: #FFF; --n-border: 1px solid #1c84c6; --n-border-hover: 1px solid #3a9ad9; --n-border-pressed: 1px solid #17699f; --n-border-focus: 1px solid #3a9ad9; --n-border-disabled: 1px solid #1c84c6; --n-width: initial; --n-height: 34px; --n-font-size: 14px; --n-padding: 0 14px; --n-icon-size: 18px; --n-icon-margin: 6px; --n-border-radius: 4px;" link="">
              <!---->
              <transition-stub name="fade-in-width-expand-transition" appear="false" persisted="false" css="true">
                <!---->
              </transition-stub><span class="n-button__content">装配线输入</span>
              <div aria-hidden="true" class="n-base-wave"></div>
              <div aria-hidden="true" class="n-button__border"></div>
              <div aria-hidden="true" class="n-button__state-border"></div>
            </button></th>
          <td>海康 ISAPI</td>
          <td>一号装配工位</td>
          <td>推理机 A</td>
          <td><span>192.168.10.21</span><span> :80</span></td>
          <td>
            <div class="n-tag" style="--n-font-weight-strong: 500; --n-avatar-size-override: calc(28px - 8px); --n-bezier: cubic-bezier(.4, 0, .2, 1); --n-border-radius: 2px; --n-border: 1px solid rgba(26, 179, 148, 0.3); --n-close-icon-size: 14px; --n-close-color-pressed: rgba(26, 179, 148, 0.18); --n-close-color-hover: rgba(26, 179, 148, 0.12); --n-close-border-radius: 2px; --n-close-icon-color: #1ab394; --n-close-icon-color-hover: #1ab394; --n-close-icon-color-pressed: #1ab394; --n-close-icon-color-disabled: #1ab394; --n-close-margin-top: 0; --n-close-margin-right: 0; --n-close-margin-bottom: 0; --n-close-margin-left: 4px; --n-close-size: 18px; --n-color: rgba(26, 179, 148, 0.1); --n-color-checkable: #0000; --n-color-checked: #1c84c6; --n-color-checked-hover: #3a9ad9; --n-color-checked-pressed: #17699f; --n-color-hover-checkable: rgba(46, 51, 56, .09); --n-color-pressed-checkable: rgba(46, 51, 56, .13); --n-font-size: 14px; --n-height: 28px; --n-opacity-disabled: 0.5; --n-padding: 0 7px; --n-text-color: #1ab394; --n-text-color-checkable: #676a6c; --n-text-color-checked: #FFF; --n-text-color-hover-checkable: #676a6c; --n-text-color-pressed-checkable: #676a6c;" disable-transitions="">
              <!----><span class="n-tag__content">已配置</span>
              <!---->
              <div class="n-tag__border"></div>
            </div>
          </td>
          <td>
            <div class="n-tag" style="--n-font-weight-strong: 500; --n-avatar-size-override: calc(28px - 8px); --n-bezier: cubic-bezier(.4, 0, .2, 1); --n-border-radius: 2px; --n-border: 1px solid rgba(248, 172, 89, 0.35); --n-close-icon-size: 14px; --n-close-color-pressed: rgba(248, 172, 89, 0.18); --n-close-color-hover: rgba(248, 172, 89, 0.12); --n-close-border-radius: 2px; --n-close-icon-color: #f8ac59; --n-close-icon-color-hover: #f8ac59; --n-close-icon-color-pressed: #f8ac59; --n-close-icon-color-disabled: #f8ac59; --n-close-margin-top: 0; --n-close-margin-right: 0; --n-close-margin-bottom: 0; --n-close-margin-left: 4px; --n-close-size: 18px; --n-color: rgba(248, 172, 89, 0.12); --n-color-checkable: #0000; --n-color-checked: #1c84c6; --n-color-checked-hover: #3a9ad9; --n-color-checked-pressed: #17699f; --n-color-hover-checkable: rgba(46, 51, 56, .09); --n-color-pressed-checkable: rgba(46, 51, 56, .13); --n-font-size: 14px; --n-height: 28px; --n-opacity-disabled: 0.5; --n-padding: 0 7px; --n-text-color: #f8ac59; --n-text-color-checkable: #676a6c; --n-text-color-checked: #FFF; --n-text-color-hover-checkable: #676a6c; --n-text-color-pressed-checkable: #676a6c;" disable-transitions="">
