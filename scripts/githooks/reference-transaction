#!/usr/bin/env python3
"""Git reference-transaction hook for the local worker-to-main pull-request workflow."""

from __future__ import annotations

import runpy
from pathlib import Path

# 直接执行 guard 源文件，避免模块导入在 hooks 目录旁生成 __pycache__。
runpy.run_path(str(Path(__file__).with_name("local_branch_guard.py")), run_name="__main__")
