exports[`the login page > renders the form it has been rendering 1`] = `
"<main class="login">
  <section class="login__panel" aria-labelledby="login-heading">
    <h1 id="login-heading" class="login__heading">SOP 合规检测系统</h1>
    <p class="login__hint">请使用本地账户登录</p>
    <!-- \`alert\` so a screen reader announces the refusal without the operator having to go
           looking for it, and the leading ✕ means the failure is not carried by colour alone
           (Q32). -->
    <!--v-if-->
    <form class="el-form el-form--default el-form--label-top">
      <div class="el-form-item asterisk-left el-form-item--label-top" role="group" aria-labelledby="el-id-0">
        <div id="el-id-0" class="el-form-item__label">登录名</div>
        <div class="el-form-item__content">
          <!-- \`id\`/\`for\` is what \`ElFormItem\`'s label binds through. Focus is taken by the
               \`onMounted\` above rather than by \`autofocus\`. -->
          <div class="el-input">
            <!-- input -->
            <!-- prepend slot -->
            <!--v-if-->
            <div class="el-input__wrapper">
              <!-- prefix slot -->
              <!--v-if--><input class="el-input__inner" name="login_name" type="text" autocomplete="username" tabindex="0"><!-- suffix slot -->
              <!--v-if-->
            </div><!-- append slot -->
            <!--v-if-->
          </div>
          <transition-group-stub name="el-zoom-in-top" appear="false" persisted="false" css="true">
            <!--v-if-->
          </transition-group-stub>
        </div>
      </div>
      <div class="el-form-item asterisk-left el-form-item--label-top" role="group" aria-labelledby="el-id-1">
        <div id="el-id-1" class="el-form-item__label">密码</div>
        <div class="el-form-item__content">
          <div class="el-input el-input--suffix">
            <!-- input -->
            <!-- prepend slot -->
            <!--v-if-->
            <div class="el-input__wrapper">
              <!-- prefix slot -->
              <!--v-if--><input class="el-input__inner" name="password" type="password" autocomplete="current-password" tabindex="0"><!-- suffix slot --><span class="el-input__suffix"><span class="el-input__suffix-inner"><!--v-if--><!--v-if--><!--v-if--><!--v-if--><!--v-if--></span></span>
            </div><!-- append slot -->
            <!--v-if-->
          </div>
          <transition-group-stub name="el-zoom-in-top" appear="false" persisted="false" css="true">
            <!--v-if-->
          </transition-group-stub>
        </div>
      </div>
      <div class="el-form-item asterisk-left el-form-item--label-top">
        <!--v-if-->
        <div class="el-form-item__content"><button aria-disabled="true" disabled="" type="submit" class="el-button el-button--primary is-disabled login__submit">
            <!--v-if--><span class="">登录</span>
          </button>
          <transition-group-stub name="el-zoom-in-top" appear="false" persisted="false" css="true">
            <!--v-if-->
          </transition-group-stub>
        </div>
      </div>
    </form>
  </section>
</main>"
`;

exports[`the protected shell > renders the navigation and the account strip it has been rendering 1`] = `
"<div class="shell">
  <header class="shell__header"><span class="shell__product">SOP 合规检测系统</span>
    <div class="shell__account"><span class="shell__user">王丽</span><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
        <!--v-if--><span class="">退出</span>
      </button></div>
  </header>
  <div class="shell__body">
    <!-- A real \`nav\` with a list, so a screen reader can enumerate the sections and a keyboard
           can tab through only the ones that lead somewhere. -->
    <nav class="shell__nav" aria-label="主导航">
      <ul class="shell__nav-list">
        <li><a aria-current="page" href="/" class="router-link-active router-link-exact-active shell__link">概览</a></li>
        <li>
          <!-- \`aria-disabled\` and the trailing note rather than grey text alone: colour is not
                 the only expression of state (Q32). --><span class="shell__link shell__link--pending" aria-disabled="true" title="该功能尚未上线">训练数据集 <small class="shell__pending-note">（未上线）</small></span>
        </li>
      </ul>
    </nav>
    <main class="shell__main">
      <!--v-if-->
      <div></div>
    </main>
  </div>
</div>"
`;

exports[`the template page > renders the import rail, draft list and retained import history 1`] = `
"<section aria-labelledby="templates-heading" class="template-management">
  <header class="template-management__header">
    <div>
      <p class="template-management__eyebrow">配置中心 / SOP</p>
      <h1 id="templates-heading" class="template-management__heading">SOP 模板</h1>
      <p class="template-management__intro"> 把规范化 Excel 留作凭据，把可运行内容留在草稿；发布版本将在后续流程中产生。 </p>
    </div>
    <div class="template-management__import-rail"><label for="template-file" class="template-management__file-label"> 导入规范化 Excel <input id="template-file" name="template-file" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"></label>
      <!--v-if--><small>失败文件也会保留，便于定位工作表、行和字段。</small>
    </div>
  </header>
  <!--v-if-->
  <!--v-if-->
  <div class="template-management__workbench">
    <section class="template-management__drafts" aria-labelledby="drafts-heading">
      <div class="template-management__section-head">
        <div>
          <h2 id="drafts-heading">可编辑草稿</h2>
          <p>每次导入都会生成新草稿，不覆盖已有内容。</p>
        </div><span class="template-management__count">1 个草稿</span>
      </div>
      <table class="template-management__table">
        <caption class="template-management__caption"> 尚未发布的 SOP 草稿 </caption>
        <thead>
          <tr>
            <th scope="col">工位</th>
            <th scope="col">步骤</th>
            <th scope="col">顺序声明</th>
            <th scope="col">修订号</th>
            <th scope="col">操作</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><span>一号装配工位</span><small>A-01</small></th>
            <td>1 个步骤</td>
            <td><span class="el-tag el-tag--success el-tag--light"><span class="el-tag__content">严格顺序</span>
              <!--v-if--></span>
            </td>
            <td>1</td>
            <td class="template-management__actions"><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
                <!--v-if--><span class=""> 编辑草稿 </span>
              </button><button aria-disabled="false" type="button" class="el-button el-button--warning is-link">
                <!--v-if--><span class=""> 发布版本 </span>
              </button>
              <!--v-if-->
            </td>
          </tr>
          <!--v-if-->
        </tbody>
      </table>
    </section>
    <section class="template-management__history" aria-labelledby="imports-heading">
      <div class="template-management__section-head">
        <div>
          <h2 id="imports-heading">导入记录</h2>
          <p>原始文件只留在控制面，不出现在草稿表格里。</p>
        </div>
      </div>
      <table class="template-management__table template-management__table--history">
        <caption class="template-management__caption"> 成功和失败的规范化 Excel 导入 </caption>
        <thead>
          <tr>
            <th scope="col">文件</th>
            <th scope="col">结果</th>
            <th scope="col">错误</th>
            <th scope="col">操作</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">一号模板.xlsx</th>
            <td><span class="el-tag el-tag--success el-tag--light"><span class="el-tag__content">已生成草稿</span>
              <!--v-if--></span>
            </td>
            <td><span class="template-management__muted">无</span></td>
            <td><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
                <!--v-if--><span class=""> 下载原文件 </span>
              </button></td>
          </tr>
          <!--v-if-->
        </tbody>
      </table>
    </section>
    <section class="template-management__versions" aria-labelledby="versions-heading">
      <div class="template-management__section-head">
        <div>
          <h2 id="versions-heading">已发布版本</h2>
          <p>版本一旦发布便不可修改；运行端消费的制品和摘要留在这里。</p>
        </div><span class="template-management__count">1 个版本</span>
      </div>
      <table class="template-management__table template-management__table--versions">
        <caption class="template-management__caption"> 不可变 SOP 版本及其可复验制品 </caption>
        <thead>
          <tr>
