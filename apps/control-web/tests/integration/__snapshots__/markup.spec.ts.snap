                <li><span><strong>actions.json</strong><small>32 字节 · bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb</small></span><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
                    <!--v-if--><span class=""> 下载 actions.json</span>
                  </button></li>
                <li><span><strong>vlm_prompts.txt</strong><small>18 字节 · cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc</small></span><button aria-disabled="false" type="button" class="el-button el-button--primary is-link">
                    <!--v-if--><span class=""> 下载 vlm_prompts.txt</span>
                  </button></li>
              </ul>
            </td>
          </tr>
          <!--v-if-->
        </tbody>
      </table>
    </section>
  </div>
  <!--teleport start-->
  <transition-stub name="dialog-fade" appear="false" persisted="true" css="true">
    <div class="el-overlay el-modal-dialog" style="z-index: 2014; display: none;">
