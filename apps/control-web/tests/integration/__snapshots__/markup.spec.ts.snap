exports[`the protected shell > renders the navigation and the account strip it has been rendering 1`] = `
"<div class="shell">
  <header class="shell__header"><span class="shell__product">SOP 合规检测系统</span>
    <div class="shell__account"><span class="shell__user">王丽</span><button class="n-button n-button--primary-type n-button--medium-type" tabindex="0" type="button" style="--n-bezier: cubic-bezier(.4, 0, .2, 1); --n-bezier-ease-out: cubic-bezier(0, 0, .2, 1); --n-ripple-duration: .6s; --n-opacity-disabled: 0.5; --n-wave-opacity: 0.6; --n-font-weight: 400; --n-color: #1c84c6; --n-color-hover: #3a9ad9; --n-color-pressed: #17699f; --n-color-focus: #3a9ad9; --n-color-disabled: #1c84c6; --n-ripple-color: #1c84c6; --n-text-color: #FFF; --n-text-color-hover: #FFF; --n-text-color-pressed: #FFF; --n-text-color-focus: #FFF; --n-text-color-disabled: #FFF; --n-border: 1px solid #1c84c6; --n-border-hover: 1px solid #3a9ad9; --n-border-pressed: 1px solid #17699f; --n-border-focus: 1px solid #3a9ad9; --n-border-disabled: 1px solid #1c84c6; --n-width: initial; --n-height: 34px; --n-font-size: 14px; --n-padding: 0 14px; --n-icon-size: 18px; --n-icon-margin: 6px; --n-border-radius: 4px;" link="">
        <!---->
        <transition-stub name="fade-in-width-expand-transition" appear="false" persisted="false" css="true">
          <!---->
        </transition-stub><span class="n-button__content">退出</span>
        <div aria-hidden="true" class="n-base-wave"></div>
        <div aria-hidden="true" class="n-button__border"></div>
        <div aria-hidden="true" class="n-button__state-border"></div>
      </button></div>
  </header>
  <div class="shell__body">
    <!-- A real \`nav\` with a list, so a screen reader can enumerate the sections and a keyboard
           can tab through only the ones that lead somewhere. -->
    <nav class="shell__nav" aria-label="主导航">
      <ul class="shell__nav-list">
        <li><a aria-current="page" href="/" class="router-link-active router-link-exact-active shell__link">概览</a></li>
      </ul>
    </nav>
    <main class="shell__main">
      <!--v-if-->
      <div></div>
    </main>
  </div>
</div>"
`;

exports[`the template page > renders the import rail, draft list and retained import history 1`] = `
"<section aria-labelledby="templates-heading" class="template-management">
  <header class="template-management__header">
    <div>
      <p class="template-management__eyebrow">配置中心 / SOP</p>
      <h1 id="templates-heading" class="template-management__heading">SOP 模板</h1>
      <p class="template-management__intro"> 把规范化 Excel 留作凭据，把可运行内容留在草稿；发布版本将在后续流程中产生。 </p>
    </div>
    <div class="template-management__import-rail"><label for="template-file" class="template-management__file-label"> 导入规范化 Excel <input id="template-file" name="template-file" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"></label>
      <!--v-if--><small>失败文件也会保留，便于定位工作表、行和字段。</small>
    </div>
  </header>
  <!--v-if-->
  <!--v-if-->
  <div class="template-management__workbench">
    <section class="template-management__drafts" aria-labelledby="drafts-heading">
      <div class="template-management__section-head">
        <div>
          <h2 id="drafts-heading">可编辑草稿</h2>
          <p>每次导入都会生成新草稿，不覆盖已有内容。</p>
        </div><span class="template-management__count">1 个草稿</span>
      </div>
      <table class="template-management__table">
        <caption class="template-management__caption"> 尚未发布的 SOP 草稿 </caption>
        <thead>
          <tr>
            <th scope="col">工位</th>
            <th scope="col">步骤</th>
            <th scope="col">顺序声明</th>
            <th scope="col">修订号</th>
            <th scope="col">操作</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row"><span>一号装配工位</span><small>A-01</small></th>
            <td>1 个步骤</td>
            <td>
              <div class="n-tag" style="--n-font-weight-strong: 500; --n-avatar-size-override: calc(28px - 8px); --n-bezier: cubic-bezier(.4, 0, .2, 1); --n-border-radius: 2px; --n-border: 1px solid rgba(26, 179, 148, 0.3); --n-close-icon-size: 14px; --n-close-color-pressed: rgba(26, 179, 148, 0.18); --n-close-color-hover: rgba(26, 179, 148, 0.12); --n-close-border-radius: 2px; --n-close-icon-color: #1ab394; --n-close-icon-color-hover: #1ab394; --n-close-icon-color-pressed: #1ab394; --n-close-icon-color-disabled: #1ab394; --n-close-margin-top: 0; --n-close-margin-right: 0; --n-close-margin-bottom: 0; --n-close-margin-left: 4px; --n-close-size: 18px; --n-color: rgba(26, 179, 148, 0.1); --n-color-checkable: #0000; --n-color-checked: #1c84c6; --n-color-checked-hover: #3a9ad9; --n-color-checked-pressed: #17699f; --n-color-hover-checkable: rgba(46, 51, 56, .09); --n-color-pressed-checkable: rgba(46, 51, 56, .13); --n-font-size: 14px; --n-height: 28px; --n-opacity-disabled: 0.5; --n-padding: 0 7px; --n-text-color: #1ab394; --n-text-color-checkable: #676a6c; --n-text-color-checked: #FFF; --n-text-color-hover-checkable: #676a6c; --n-text-color-pressed-checkable: #676a6c;" disable-transitions="">
                <!----><span class="n-tag__content">严格顺序</span>
                <!---->
                <div class="n-tag__border"></div>
              </div>
            </td>
            <td>1</td>
            <td class="template-management__actions"><button class="n-button n-button--primary-type n-button--medium-type" tabindex="0" type="button" style="--n-bezier: cubic-bezier(.4, 0, .2, 1); --n-bezier-ease-out: cubic-bezier(0, 0, .2, 1); --n-ripple-duration: .6s; --n-opacity-disabled: 0.5; --n-wave-opacity: 0.6; --n-font-weight: 400; --n-color: #1c84c6; --n-color-hover: #3a9ad9; --n-color-pressed: #17699f; --n-color-focus: #3a9ad9; --n-color-disabled: #1c84c6; --n-ripple-color: #1c84c6; --n-text-color: #FFF; --n-text-color-hover: #FFF; --n-text-color-pressed: #FFF; --n-text-color-focus: #FFF; --n-text-color-disabled: #FFF; --n-border: 1px solid #1c84c6; --n-border-hover: 1px solid #3a9ad9; --n-border-pressed: 1px solid #17699f; --n-border-focus: 1px solid #3a9ad9; --n-border-disabled: 1px solid #1c84c6; --n-width: initial; --n-height: 34px; --n-font-size: 14px; --n-padding: 0 14px; --n-icon-size: 18px; --n-icon-margin: 6px; --n-border-radius: 4px;" link="">
